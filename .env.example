# Telegram Bot
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Mini App URL, позже понадобится для продакшена
WEBAPP_URL=https://your-domain.example.com

# Database
DATABASE_URL=sqlite:///./data/app.db

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# LLM
LLM_PROVIDER=mock

# OpenAI-compatible provider, понадобится позже
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama, если будем использовать локальный LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1